@'
# =============================================================================
# Polygon Migration Tool - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your private values.
#
# IMPORTANT: Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Settings
# -----------------------------------------------------------------------------

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
#
# Assignment local setup uses host port 5434 because port 5432 may already
# be occupied by another PostgreSQL instance.
#
# Docker:
# docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5434:5432 -d postgres:15

DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5434

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
#
# Docker:
# docker run --name polygon-redis -p 6379:6379 -d redis:7

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=False

# -----------------------------------------------------------------------------
# Polygon API
# -----------------------------------------------------------------------------
#
# Generate API credentials from your Polygon account.
# Never commit the actual credentials.

POLYGON_API_KEY=your-polygon-api-key
POLYGON_API_SECRET=your-polygon-api-secret

# -----------------------------------------------------------------------------
# Cloud Storage
# -----------------------------------------------------------------------------
#
# The migration tool uses a provider abstraction so the migration workflow
# does not depend directly on a cloud provider implementation.
#
# Current provider implemented: Azure Blob Storage.
#
# Authentication uses an Azure service principal. Do not commit credentials.

STORAGE_PROVIDER=azure

AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_CONTAINER_NAME=testcases

# -----------------------------------------------------------------------------
# Custom Checker Compilation
# -----------------------------------------------------------------------------
#
# Optional. If unset, the application uses the system temporary directory.
# Requires g++ if custom checker compilation is needed.
#
# CUSTOM_CHECKER_DIR=/path/to/checker/directory

# -----------------------------------------------------------------------------
# Quick Start
# -----------------------------------------------------------------------------
#
# 1. Start PostgreSQL and Redis:
#    docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5434:5432 -d postgres:15
#    docker run --name polygon-redis -p 6379:6379 -d redis:7
#
# 2. Apply migrations:
#    python manage.py migrate
#
# 3. Create a superuser:
#    python manage.py createsuperuser
#
# 4. Run the development server:
#    python manage.py runserver
#
# 5. Open:
#    http://localhost:8000/
#
'@ | Set-Content .\PolygonMigration\.env.example -Encoding UTF8